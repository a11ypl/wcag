{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"Skip install for static site\"",
  "buildCommand": "echo \"Use committed public directory\"",
  "outputDirectory": "public",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/kurs",
      "destination": "/kurs-semantyczny-html",
      "permanent": false
    },
    {
      "source": "/wcag-prostym-jezykiem/1-2-1-tylko-audio-i-tylko-wideo-nagranie",
      "destination": "/wcag-prostym-jezykiem/1-2-1-tylko-audio-oraz-tylko-wideo",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/1-2-2-napisy-rozszerzone-nagranie",
      "destination": "/wcag-prostym-jezykiem/1-2-2-napisy-rozszerzone",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/1-2-3-audiodeskrypcja-lub-alternatywa-dla-mediow-nagranie",
      "destination": "/wcag-prostym-jezykiem/1-2-3-audiodeskrypcja-lub-alternatywa-dla-mediow",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/1-2-5-audiodeskrypcja-nagranie",
      "destination": "/wcag-prostym-jezykiem/1-2-5-audiodeskrypcja",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/1-4-2-kontrola-dzwieku",
      "destination": "/wcag-prostym-jezykiem/1-4-2-kontrola-odtwarzania-dzwieku",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/2-1-4-jednoznakowe-skroty-klawiaturowe",
      "destination": "/wcag-prostym-jezykiem/2-1-4-skroty-klawiszowe-znakowe",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/2-3-1-trzy-blyski-lub-ponizej-progu",
      "destination": "/wcag-prostym-jezykiem/2-3-1-trzy-blyski-lub-wartosci-ponizej-progu",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/2-4-5-wiele-drog",
      "destination": "/wcag-prostym-jezykiem/2-4-5-wiele-sposobow",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/2-5-1-gesty-wskazujace",
      "destination": "/wcag-prostym-jezykiem/2-5-1-gesty-wskaznika",
      "permanent": true
    },
    {
      "source": "/wcag-prostym-jezykiem/2-5-2-anulowanie-akcji-wskaznikiem",
      "destination": "/wcag-prostym-jezykiem/2-5-2-anulowanie-wskazania",
      "permanent": true
    },
    {
      "source": "/aria",
      "destination": "/baza-wiedzy/aria",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://auditor.sitelint.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://api.web3forms.com https://auditor.sitelint.com; form-action 'self' mailto: https://api.web3forms.com; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        }
      ]
    }
  ]
}
